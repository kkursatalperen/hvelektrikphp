# HV Elektrik - PHP Backend Ortam Degiskenleri
# Bu dosyayi kopyalayip ".env" olarak kaydedin (backend-php/.env) ve gercek degerleri girin.
# .env dosyasi asla git'e commit edilmemeli / hosting'de public/ klasorunun ICINE konulmamali.

# --- MySQL baglantisi (hosting kontrol panelinde "Veritabanlari" bolumunden olusturulur) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Oturum (JWT) imzalama anahtari. Rastgele, uzun, tahmin edilemez bir string olmali.
# Uretmek icin: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=

# --- Admin paneli girisi ---
ADMIN_EMAIL=admin@hvelektrik.com.tr
ADMIN_PASSWORD=

# --- Cloudinary (CV/gorsel yukleme) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Resend (mail bildirimi) - opsiyonel, bos birakilirsa mail gonderimi devre disi kalir ---
RESEND_API_KEY=
SENDER_EMAIL=onboarding@resend.dev
NOTIFY_EMAIL=info@hvelektrik.com.tr
